# Backend environment variables — copy this file to .env.local and fill in values
# NEVER commit .env.local to git

# Firebase Admin SDK (from service account JSON)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=govguide-schemes

# Google Gemini
GEMINI_API_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Semi-automatic ingestion controls
# Stage 1 default: keep true (shadow mode, no auto publish)
INGEST_SHADOW_MODE=true
INGEST_DETECT_DELETIONS=true
AUTO_PUBLISH_MIN_SCORE=85
MAX_SOURCE_TIMEOUT_MS=15000
RETRY_COUNT=2
FETCH_DELAY_MS=250
EMBED_DELAY_MS=200
PINECONE_BATCH_SIZE=50
MAX_AUTO_PUBLISH_FAILURE_RATE=0.4

# JWT Secret (generate a random 64-char hex string)
JWT_SECRET=change_me_to_a_random_secret_string_64_chars

# App
NODE_ENV=development
